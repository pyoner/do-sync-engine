  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyoner/do-sync-engine.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
