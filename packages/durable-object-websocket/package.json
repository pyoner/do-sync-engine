{
  "name": "@do-sync-engine/durable-object-websocket",
  "version": "0.0.0",
  "description": "Cloudflare Durable Object WebSocket transport for do-sync-engine",
  "homepage": "https://github.com/pyoner/do-sync-engine#readme",
  "bugs": {
    "url": "https://github.com/pyoner/do-sync-engine/issues"
