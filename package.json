{
  "name": "do-sync-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "release:version": "pnpm -r --filter \"./packages/*\" exec npm pkg set version=$VERSION",
    "release:publish": "pnpm -r --filter \"./packages/*\" publish --tag alpha",
    "prepare": "vp config"
  },
  "devDependencies": {
    "effect": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
